   "source": [
    "x = np.arange(-1,1,0.01)\n",
    "p1 = x\n",
    "p2 = x*x\n",
    "p3 = x*x*x\n",
    "p4 = x*x*x*x\n",
    "p5 = x*x*x*x*x"
   ]
  },
